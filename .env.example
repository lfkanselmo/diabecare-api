# Base de datos
DB_URL=jdbc:postgresql://localhost:5432/diabecare_dev
DB_USERNAME=
DB_PASSWORD=

# JWT — mínimo 32 caracteres para HS256
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Seguridad
BCRYPT_STRENGTH=12

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@diabecare.com

# Correo transaccional (Resend) — vacío degrada a loguear el link en vez de enviarlo
RESEND_API_KEY=
RESEND_FROM_ADDRESS=DiabeCare <onboarding@resend.dev>
FRONTEND_BASE_URL=http://localhost:4200

# Push nativo móvil (FCM) — vacío degrada a no-op
FCM_SERVICE_ACCOUNT_JSON=
